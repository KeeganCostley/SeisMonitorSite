# Copy this file to .env.local and fill in real values. .env.local is
# gitignored -- never commit real keys. Restart `npm run dev` after editing.

# --- Stripe (card payments) -------------------------------------------------
# From https://dashboard.stripe.com/apikeys -- use the *test* secret key
# (starts sk_test_) while building, switch to the live key (sk_live_) only
# once you're ready to actually take real card payments.
STRIPE_SECRET_KEY=sk_test_...

# From https://dashboard.stripe.com/webhooks after you add an endpoint
# pointing at https://<your-domain>/api/webhooks/stripe (or, for local
# testing, whatever the Stripe CLI's `stripe listen` prints).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Volley (pay by bank) ----------------------------------------------------
# From https://dashboard.volley.nz/settings/apikeys -- use a test key
# (authkey_test_...) first; Volley routes test-key payments to their own
# dummy test bank account, not yours, so nothing real can be charged by
# mistake. Switch to authkey_live_... only once you're ready to go live.
VOLLEY_API_KEY=authkey_test_...

# The ID of YOUR verified receiving bank account in Volley's system -- you
# get this from Volley during onboarding (contact them to verify a bank
# account; ask your friend at Volley if you're not sure how). Looks like
# bankaccount_xxxxxxxxxxxxx. Not needed for pure test-mode payment requests
# in some flows, but required by the API request shape either way -- Volley
# will tell you what to use for the test account if it differs.
VOLLEY_BANK_ACCOUNT_ID=bankaccount_...

# From https://dashboard.volley.nz/webhooks after you add an endpoint
# pointing at https://<your-domain>/api/webhooks/volley, subscribed to
# payment.status_updated. Shown once, at creation time -- save it then.
VOLLEY_WEBHOOK_SECRET=...
